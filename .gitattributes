# Files that end up inside a Linux container must keep LF endings. A shell
# script with CRLF fails there with "bad interpreter", which would bite anyone
# building the images on Windows.
*.sh            text eol=lf
Dockerfile      text eol=lf
*.conf          text eol=lf
*.template      text eol=lf
docker-compose.yml text eol=lf
.dockerignore   text eol=lf
.env.example    text eol=lf
